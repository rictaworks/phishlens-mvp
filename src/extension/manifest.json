{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "0.0.1",
  "description": "Webメール上でフィッシング/AI生成メールの可能性を判定します(MVP)",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishLens"
  }
}
