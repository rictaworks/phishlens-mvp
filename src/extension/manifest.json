{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "0.0.1",
  "description": "Webメール上でフィッシング/AI生成メールの可能性を判定します(MVP)",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "oauth2": {
    "client_id": "225403922940-o4oljbl9hcq9o6qc027fhd4aimmeji9n.apps.googleusercontent.com",
    "scopes": ["openid"]
  },
  "background": {
    "service_worker": "dist/src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishLens"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/vendor/fontawesome/css/all.min.css", "dist/vendor/fontawesome/webfonts/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
